{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "lib": ["ES2020", "DOM"],
    "types": [],
    "allowJs": true,
    "noEmit": true,
    "rootDir": "./",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": ["./", "../../types", "../types", "../../../types"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "supabase-types.d.ts",
    "global-types.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
