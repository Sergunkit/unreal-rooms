[Unit]
Description=Unreal Rooms game API (dev instance)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/unreal-rooms/server
ExecStart=%h/.hermes/tools/node-26.12.1-linux-x64/bin/node src/index.ts
Environment=PORT=8011
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
